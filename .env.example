# PayPal sandbox app credentials (developer.paypal.com -> Apps & Credentials -> Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# AI (optional). Anthropic is the default; OPENAI_API_KEY is an alternative.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Optional: require a passcode for owner routes/UI (agents still use per-agent keys)
# OWNER_PASSCODE=

PORT=4320
# Public base URL PayPal redirects back to (must be reachable by your browser)
PUBLIC_URL=http://localhost:4320
# DB_PATH=data/allowance.db
